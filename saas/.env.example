# Copy to .env.local and fill in. DATABASE_URL is required; the rest are
# optional for local dev.

# Public base URL of this web app (used to build links in emails, Stripe
# redirect URLs, etc.).
APP_URL=http://localhost:3000

# Neon (serverless Postgres) connection string. Required — the data layer
# throws at startup if it is unset. The schema is created lazily on first use.
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Stripe (billing). Leave blank to run billing in "not configured" mode — the
# pricing page still renders and everyone stays on the Free plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Transactional email. Leave blank to log reset/invite links to the server
# console instead of sending real email (handy for local dev).
RESEND_API_KEY=
EMAIL_FROM=Lifeline <noreply@lifeline.app>

# Public URL the dashboard points at for the user's own mesh node (the
# messenger). Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_NODE_URL=http://localhost:8080
