# Copy to .env.local and fill in. All are optional for local dev except APP_URL.
APP_URL=http://localhost:3000

# SQLite file (default ./data/lifeline.db). For production, swap the data layer
# to Postgres — the SQL is kept standard to ease that migration.
DATABASE_FILE=./data/lifeline.db

# Stripe (billing). Leave blank to run billing in "not configured" mode — the
# pricing page still renders and everyone stays on the Free plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Transactional email. Leave blank to log reset/invite links to the server
# console instead of sending real email (handy for local dev).
RESEND_API_KEY=
EMAIL_FROM=Lifeline <noreply@lifeline.app>
